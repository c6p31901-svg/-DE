<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>湘南・三浦海岸美化 Web GIS Dashboard</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Leaflet CSS & JS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <!-- Turf.js (円領域などの判定用) -->
    <script src="https://cdn.jsdelivr.net/npm/@turf/turf@6/turf.min.js"></script>
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <!-- 外部CSSの読み込み -->

  <script type="module" crossorigin src="/assets/app-dsYz0L0q.js"></script>
  <link rel="modulepreload" crossorigin href="/assets/index.esm-DT7gI91q.js">
  <link rel="stylesheet" crossorigin href="/assets/app-DbqN2xzk.css">
</head>
<body class="bg-slate-950 font-sans text-slate-100 overflow-hidden">

    <!-- 🗺️ 地図エリア -->
    <div id="leaflet-map" class="absolute inset-0 z-0" aria-label="インタラクティブマップ"></div>

    <!-- ☰ ハンバーガーボタン & GPSステータス-->
    <div class="absolute top-6 left-6 z-10 flex items-center gap-3">
        <button id="menu-open-btn" aria-label="メニューを開く" class="hamburger-btn">
            <i class="fa-solid fa-bars text-xl"></i>
        </button>
        <!-- 📍 GPSステータス表示パネル -->
        <div id="geo-status-badge" class="geo-status-badge">
            <span id="geo-status-dot" class="w-2.5 h-2.5 rounded-full bg-yellow-400"></span>
            <span id="geo-status-text" class="text-slate-200">現在地を取得中...</span>
        </div>
    </div>

    <!-- ⬛ メニュー背景オーバーレイ -->
    <div id="menu-overlay" class="menu-overlay hidden"></div>

    <!-- 📱 サイドメニュー -->
    <aside id="side-menu" class="side-menu-drawer is-closed">
        <div class="drawer-header">
            <button id="menu-close-btn" aria-label="メニューを閉じる" class="drawer-close-btn">
                <i class="fa-solid fa-chevron-left"></i>
            </button>
            <span class="drawer-title">メニュー</span>
        </div>

        <nav class="drawer-nav">
            <button id="nav-notice-btn" class="drawer-item">お知らせ</button>
            <button id="nav-trash-btn" class="drawer-item">ごみ一覧</button>
            <button id="nav-notify-btn" class="drawer-item">通知</button>
        </nav>
    </aside>

    <!-- 📄 お知らせ画面 -->
     <section id="notice-page" class="fullscreen-page hidden">
        <div class="p-6 max-w-2xl mx-auto w-full">
            <button class="back-to-map-btn mb-6" aria-label="マップに戻る">
                <i class="fa-solid fa-chevron-left"></i>
            </button>
            <div class="space-y-10 pt-2">
                <article class="space-y-3">
                    <h2 class="text-xl font-bold tracking-tight">ボランティア活動募集</h2>
                    <div class="border-b-2 border-slate-400 w-full my-2"></div>
                </article>
                <article class="space-y-3">
                    <h2 class="text-xl font-bold tracking-tight">危険海岸漂着物のお知らせ</h2>
                    <div class="border-b-2 border-slate-400 w-full my-2"></div>
                </article>
            </div>
        </div>
    </section>

    <!-- 🖼️ ごみ一覧機能画面（DB連携版） -->
    <section id="trash-page"
        class="fixed inset-0 bg-white text-black z-50 hidden flex-col overflow-y-auto">

        <header class="flex items-center gap-4 px-6 py-4 border-b border-slate-300 sticky top-0 bg-white z-10">
            <button
                class="back-to-map-btn text-2xl text-black hover:opacity-70 cursor-pointer p-1"
                aria-label="マップに戻る">
                <i class="fa-solid fa-chevron-left"></i>
            </button>

            <h1 class="text-lg font-bold text-center flex-1 pr-8">
                ごみ一覧機能
            </h1>
        </header>

        <!-- データベースから取得した投稿を表示する領域 -->
        <div id="trash-list" class="p-6 max-w-2xl mx-auto w-full space-y-6">
            <p class="text-slate-600">投稿を読み込んでいます...</p>
        </div>

    </section>

    
    <!-- 🔔 通知画面 -->
    <section id="notify-page" class="fullscreen-page hidden">
        <header class="flex items-center gap-4 px-6 py-4 border-b border-slate-200 sticky top-0 bg-white z-10">
            <button class="back-to-map-btn text-black p-1" aria-label="マップに戻る">
                <i class="fa-solid fa-chevron-left"></i>
            </button>
            <h1 class="text-lg font-bold text-center flex-1 pr-8">通知機能</h1>
        </header>

        <div class="p-6 max-w-2xl mx-auto w-full text-center text-slate-500 pt-20">
            （通知画面のデザインは準備中です）
        </div>
    </section>

    <!-- ⚙️ スクリプト -->
    <script>
        let userMarker = null;
        let isInitialPositionSet = false;
        let isInsideAllowedZone = false;

        const allowedZones = [
            { id: 'west', center: [35.3172, 139.3875], radius: 400, color: '#eab308', popup: "<strong>西側エリア</strong><br>ゴミ量: 中" },
            { id: 'east', center: [35.3168, 139.4010], radius: 600, color: '#ef4444', popup: "<strong>東側エリア</strong><br>ゴミ量: 多 (優先回収エリア)" }
        ];

        function initMap() {
            const defaultLatLng = [35.2100, 139.6500];
            
            map = L.map('leaflet-map', {
                zoomControl: false, 
                attributionControl: false 
            }).setView(defaultLatLng, 12);

            L.control.zoom({ position: 'bottomright' }).addTo(map);

            L.tileLayer("https://cyberjapandata.gsi.go.jp/xyz/seamlessphoto/{z}/{x}/{y}.jpg", {
                maxNativeZoom: 18,
                minZoom: 10
            }).addTo(map);

            allowedZones.forEach(z => {
                L.circle(z.center, {
                    radius: z.radius,
                    color: z.color,
                    fillColor: z.color,
                    fillOpacity: 0.4,
                    weight: 2
                }).addTo(map).bindPopup(z.popup);
            });

            L.circle([35.3168, 139.3985], {
                radius: 200, color: '#a855f7', fillColor: '#a855f7', fillOpacity: 0.6, weight: 2
            }).addTo(map).bindPopup("<strong>注射器発見要注意区域</strong>");

            L.marker([35.31650, 139.39850], {
                icon: L.divIcon({
                    className: 'custom-pin-danger',
                    html: '<div class="bg-red-500 text-white rounded-full p-2.5 shadow-lg border-2 border-white flex items-center justify-center w-10 h-10 animate-bounce text-sm">⚠️</div>',
                    iconSize: [40, 40],
                    iconAnchor: [20, 20]
                })
            }).addTo(map);

            loadGeoJSONOnMap();

            window.loadGarbagePostsOnMap?.(map);
            
            startGeolocationWatch();

            setTimeout(() => { map.invalidateSize(); }, 300);
        }

        // JSONファイル（locations.json）からGeoJSONデータを読み込みマップ上に表示
        
function loadGeoJSONOnMap() {
    const customTrashIcon = L.divIcon({
        className: 'custom-trash-icon',
        html: '<div class="bg-emerald-600 text-white p-2 rounded-full border-2 border-white shadow-md text-xs flex items-center justify-center w-8 h-8">🗑️</div>',
        iconSize: [32, 32],
        iconAnchor: [16, 16]
    });

    // GeoJSONのマーカーを地図に追加する共通処理
    function addGeoJSONLayer(data, sourceName) {
        if (!data || !data.features) {
            console.error(`${sourceName}: GeoJSON形式ではありません。`);
            return;
        }

        const layer = L.geoJSON(data, {
            pointToLayer: function (feature, latlng) {
                return L.marker(latlng, {
                    icon: customTrashIcon
                });
            },
            onEachFeature: function (feature, layer) {
                const props = feature.properties || {};
                const name = props.name || 'ごみ置き場';
                const description =
                    props.description || '詳細情報なし';

                const popupContent = document.createElement('div');
                popupContent.className = 'p-1 max-w-xs text-slate-900';

                const title = document.createElement('strong');
                title.className = 'text-base text-emerald-800';
                title.textContent = name;

                const detail = document.createElement('div');
                detail.className =
                    'mt-2 text-xs leading-relaxed overflow-hidden';
                detail.textContent = description;

                popupContent.appendChild(title);
                popupContent.appendChild(detail);

                layer.bindPopup(popupContent);
            }
        });

        layer.addTo(map);

        console.log(
            `${sourceName}から追加したマーカー数：`,
            layer.getLayers().length
        );
    }

    // 既存のごみ置き場データ
    fetch('/locations.json')
        .then(response => {
            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            return response.json();
        })
        .then(data => addGeoJSONLayer(data, 'locations.json'))
        .catch(error => {
            console.error('locations.jsonの読み込み失敗:', error);
        });

    // 追加のごみ置き場データ
    fetch('/app/Untitled.geojson')
        .then(response => {
            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            return response.json();
        })
        .then(data => addGeoJSONLayer(data, 'Untitled.geojson'))
        .catch(error => {
            console.error('Untitled.geojsonの読み込み失敗:', error);
        });
}


        
        function startGeolocationWatch() {
            if (!navigator.geolocation) {
                updateStatusBadge(false, "Geolocation非対応ブラウザ");
                return;
            }

            
            const userIcon = L.divIcon({
                className: 'custom-user-icon',
                html: '<div class="relative"><div class="w-5 h-5 bg-blue-500 rounded-full border-2 border-white shadow-md"></div><div class="absolute -inset-1 rounded-full bg-blue-500/40 animate-ping"></div></div>',
                iconSize: [20, 20],
                iconAnchor: [10, 10]
            });

            navigator.geolocation.watchPosition(
                (position) => {
                    const lat = position.coords.latitude;
                    const lng = position.coords.longitude;

                    
                    if (!userMarker) {
                        userMarker = L.marker([lat, lng], { icon: userIcon }).addTo(map).bindPopup("現在地");
                    } else {
                        userMarker.setLatLng([lat, lng]);
                    }

                    if (!isInitialPositionSet) {
                        map.setView([lat, lng], 15);
                        isInitialPositionSet = true;
                    }

                    
                    const userPoint = turf.point([lng, lat]);
                    isInsideAllowedZone = false;

                    for (const zone of allowedZones) {
                        const zoneCenter = turf.point([zone.center[1], zone.center[0]]);
                        const distanceMeters = turf.distance(userPoint, zoneCenter, { units: 'meters' });
                        
                        if (distanceMeters <= zone.radius) {
                            isInsideAllowedZone = true;
                            break;
                        }
                    }

                    
                    if (isInsideAllowedZone) {
                        updateStatusBadge(true, "エリア内: DB登録可能");
                        savePositionToDatabase(lat, lng);
                    } else {
                        updateStatusBadge(false, "エリア外: DB反映除外");
                    }
                },
                (error) => {
                    updateStatusBadge(false, "位置情報の取得失敗");
                },
                { enableHighAccuracy: true, timeout: 10000, maximumAge: 0 }
            );
        }

        
        function updateStatusBadge(isInside, message) {
            const dot = document.getElementById('geo-status-dot');
            const text = document.getElementById('geo-status-text');

            text.innerText = message;
            if (isInside) {
                dot.className = "w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse";
            } else {
                dot.className = "w-2.5 h-2.5 rounded-full bg-rose-500";
            }
        }

        
        function savePositionToDatabase(lat, lng) {
            console.log(`[DB反映実行] 緯度=${lat}, 経度=${lng}`);
        }

        // --- UI制御 ---
        const sideMenu = document.getElementById('side-menu');
        const overlay = document.getElementById('menu-overlay');
        const pages = [
            document.getElementById('notice-page'),
            document.getElementById('trash-page'),
            document.getElementById('notify-page')
        ];

        function toggleMenu(open) {
            sideMenu.classList.toggle('is-closed', !open);
            overlay.classList.toggle('hidden', !open);
        }

        function showPage(targetPage) {
            toggleMenu(false);
            pages.forEach(page => page.classList.add('hidden'));
            targetPage.classList.remove('hidden');
        }

        function returnToMap() {
            pages.forEach(page => page.classList.add('hidden'));
            toggleMenu(false);
        }

        document.getElementById('menu-open-btn').addEventListener('click', () => toggleMenu(true));
        document.getElementById('menu-close-btn').addEventListener('click', () => toggleMenu(false));
        overlay.addEventListener('click', () => toggleMenu(false));

        document.getElementById('nav-notice-btn').addEventListener('click', () => showPage(pages[0]));
        document.getElementById('nav-trash-btn').addEventListener('click', () => showPage(pages[1]));
        document.getElementById('nav-notify-btn').addEventListener('click', () => showPage(pages[2]));

        document.querySelectorAll('.back-to-map-btn').forEach(btn => {
            btn.addEventListener('click', returnToMap);
        });

        window.addEventListener('DOMContentLoaded', initMap);
        window.addEventListener('resize', () => { if (map) map.invalidateSize(); });
    </script>
    <script type="module" src="./trash-list.js"></script>
</body>
</html>
